erDiagram

    partner_type {
        varchar code PK "AGGREGATOR | DIRECT | INDIVIDUAL"
        varchar name "Human readable"
        text description
    }

    partner {
        uuid id PK
        varchar code UK
        varchar name
        varchar partner_type FK
        numeric global_rating
        smallint global_priority
        boolean is_active
        timestamp created_at
        timestamp updated_at
    }

    partner_preference {
        uuid id PK
        uuid partner_id FK
        uuid spec_id FK "nullable"
        numeric rating "nullable"
        smallint priority "nullable"
        boolean is_active
        timestamp created_at
        timestamp updated_at
    }

    partner_type ||--|{ partner : defines
    partner ||--o{ partner_preference : has