erDiagram

    entity_type {
        varchar code PK "PARTNER, VEHICLE"
        varchar name
        text description
        varchar owning_service
        boolean is_active
        timestamp created_at
        timestamp updated_at
    }

    spec_definition {
        uuid id PK
        varchar code UK "e.g. MAX_WEIGHT_KG, ORDER_TYPE"
        varchar name
        text description
        varchar data_type "STRING | NUMERIC | BOOLEAN | DATE | TIME | TIMESTAMP"
        varchar value_scope "CAPABILITY | CONSTRAINT | BOTH"
        boolean allows_hierarchy
        boolean is_catalog_based "TRUE for catalogs, FALSE for scalar specs"
        boolean is_active
        timestamp created_at
        timestamp updated_at
    }

    entity_type_spec_mapping {
        uuid id PK
        varchar entity_type_code FK
        uuid spec_definition_id FK
        boolean is_required "Whether this spec is mandatory for this entity type"
        boolean is_active
        timestamp created_at
        timestamp updated_at
        
        unique_constraint "entity_type_code, spec_definition_id"
    }

    catalog_entry {
        uuid id PK
        uuid spec_definition_id FK "Only for catalog-based specs"
        varchar code UK "CARGO, ECOM, PHARMA"
        varchar name
        text description
        uuid parent_id FK nullable "For hierarchical catalogs"
        integer sort_order nullable
        boolean is_active
        timestamp created_at
        timestamp updated_at
    }

    entity_type_catalog_restrictions {
        uuid id PK
        varchar entity_type_code FK
        uuid catalog_entry_id FK
        boolean is_allowed "Whether this catalog entry is valid for this entity type"
        boolean is_active
        timestamp created_at
        timestamp updated_at
        
        unique_constraint "entity_type_code, catalog_entry_id"
    }

    entity_spec_attributes {
        uuid id PK
        varchar entity_type FK
        uuid entity_id
        uuid spec_definition_id FK "References spec_definition directly"
        uuid catalog_entry_id FK nullable "Only for catalog-based specs"
        boolean is_capable "TRUE if entity has this capability/meets constraint"
        varchar string_value nullable "For STRING data_type when not catalog-based"
        decimal numeric_value nullable "For NUMERIC data_type"
        boolean boolean_value nullable "For BOOLEAN data_type"
        date date_value nullable "For DATE data_type"
        time time_value nullable "For TIME data_type"
        timestamp timestamp_value nullable "For TIMESTAMP data_type"
        timestamp effective_from
        timestamp effective_to nullable
        boolean is_active
        timestamp created_at
        timestamp updated_at
        
        constraint check_entity_type_spec_mapping
        "entity_type and spec_definition_id must exist in entity_type_spec_mapping"
        
        constraint check_catalog_consistency 
        "If catalog_entry_id is not null, then catalog_entry.spec_definition_id must equal spec_definition_id"
        
        constraint check_entity_type_catalog_restriction
        "If catalog_entry_id is not null, then entity_type and catalog_entry_id must be allowed in entity_type_catalog_restrictions"
        
        constraint check_value_consistency
        "Exactly one value column should be populated based on spec_definition.data_type and is_catalog_based"
    }

    entity_type ||--|{ entity_type_spec_mapping : defines_applicable_specs
    spec_definition ||--|{ entity_type_spec_mapping : applicable_to_entity_types
    spec_definition ||--|{ entity_spec_attributes : defines
    spec_definition ||--|{ catalog_entry : "options_for (when is_catalog_based=TRUE)"
    entity_type ||--|{ entity_type_catalog_restrictions : restricts_catalog_values
    catalog_entry ||--|{ entity_type_catalog_restrictions : restricted_by_entity_types
    catalog_entry ||--o{ entity_spec_attributes : selected_value
    catalog_entry ||--o{ catalog_entry : parent_child
    entity_type ||--|{ entity_spec_attributes : scoped_to